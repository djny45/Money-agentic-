MODE=DRY_RUN
DATABASE_URL=sqlite:///data/money_agentic.db

# External API credentials — keep secrets in your deployment environment.
# Add only the providers you actually use.
CPAGRIP_API_KEY=
CPAGRIP_API_URL=

POSTIZ_API_KEY=
POSTIZ_API_URL=

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

MASTODON_ACCESS_TOKEN=
MASTODON_BASE_URL=

# Optional hosted LLM API session
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

DEFAULT_COUNTRY=IN
MAX_DAILY_POSTS=20
MIN_EXPERIMENT_SAMPLE=30
AUTO_PUBLISH=false

# Optional local/self-hosted image generation
COMFYUI_URL=http://comfyui:8188

# Optional control-panel token for mutating API operations
CONTROL_PANEL_TOKEN=
