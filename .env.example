MODE=DRY_RUN
DATABASE_URL=sqlite:///data/money_agentic.db

# API / integration section
# Never commit real secrets to GitHub.
CPAGRIP_API_KEY=
CPAGRIP_API_URL=

POSTIZ_API_KEY=
POSTIZ_API_URL=

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

MASTODON_ACCESS_TOKEN=
MASTODON_BASE_URL=

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=phi3

# Optional alternate self-hosted inference backend
LLM_PROVIDER=ollama
LOCALAI_URL=http://localai:8080
LOCALAI_MODEL=local-model

DEFAULT_COUNTRY=IN
MAX_DAILY_POSTS=20
MIN_EXPERIMENT_SAMPLE=30
AUTO_PUBLISH=false

# Optional local/self-hosted open-source image generation
COMFYUI_URL=http://comfyui:8188
